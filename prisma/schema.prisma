generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth models (NextAuth / Auth.js v5) ───────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  callReviews      CallReview[]
  practiceSessions PracticeSession[]
  liveSessions     LiveSession[]
  granolaMeetings  GranolaMeeting[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Access control ────────────────────────────────────────────────────────

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("user") // "user" or "admin"
  createdAt DateTime @default(now())
  addedBy   String?  // email of admin who added this entry
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "whitelist.add", "whitelist.remove", etc.
  actor     String   // email of user who performed the action
  target    String?  // target email or resource
  details   String?  // optional JSON details
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Granola meeting cache ──────────────────────────────────────────────────

model GranolaMeeting {
  id             String   @id // Granola meeting UUID
  title          String
  date           DateTime
  participants   String   @default("[]") // JSON array of participant names/emails
  transcript     String?  // full transcript, null until fetched
  durationMinutes Int?
  syncedAt       DateTime @default(now())
  reviewId       String?  // linked CallReview ID if already analyzed

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
}

// ─── App models ────────────────────────────────────────────────────────────

model CallReview {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  title           String
  callDate        DateTime
  transcriptText  String
  granolaId       String?
  durationMinutes Int?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Voss dimensions scores (0-10)
  tacticalEmpathy     Float @default(0)
  mirroring           Float @default(0)
  labeling            Float @default(0)
  calibratedQuestions Float @default(0)
  thatsRight          Float @default(0)
  usingNo             Float @default(0)
  accusationAudit     Float @default(0)
  lossFraming         Float @default(0)
  ackermanBargaining  Float @default(0)
  blackSwanDiscovery  Float @default(0)

  overallScore Float @default(0)

  feedbackJson  String
  coachingNotes String?

  @@index([callDate])
  @@index([userId])
  @@index([userId, callDate])
}

model PracticeSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  drillType String
  score     Float    @default(0)
  rounds    Int      @default(0)
  notes     String?
  sessionJson String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LiveSession {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  nudgesJson         String    @default("[]")
  transcriptSnippets String    @default("[]")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
